# ============ Server ============
NODE_ENV=development
PORT=5003

# ============ Database MySQL ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bbpom_ai

# ============ Auth / JWT ============
JWT_SECRET=ganti_dengan_secret_yang_kuat
JWT_EXPIRES_IN=1d

# ============ CORS ============
CORS_ORIGIN=http://localhost:3004

# ============ Embedding / RAG ============
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEARCH_MIN_SCORE=0.15
SEARCH_RESULT_LIMIT=5

# ============ AI / LLM ============
# Provider: openai | gemini | deepseek — bisa lebih dari satu (dipisah koma)
AI_PROVIDER=gemini,deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ Keycloak (SSO) ============
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=local-ai
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
